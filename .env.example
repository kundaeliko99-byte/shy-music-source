# Browser-safe Supabase config. The publishable key is not a secret, but it
# must belong to a Supabase project with correct RLS policies.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Server-only Supabase config. Never expose this value in client code or mobile builds.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: Android wrapper target. Use your deployed SHY URL.
# The Android app loads this URL so it stays synced with the web app/backend.
CAPACITOR_SERVER_URL=https://your-deployed-shy-domain.example
