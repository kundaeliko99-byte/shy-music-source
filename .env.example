# Browser-safe Supabase config. The publishable key is not a secret, but it
# must belong to a Supabase project with correct RLS policies.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Server-only Supabase config. Never expose this value in client code or mobile builds.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Official production website while SHY has no custom domain.
# Lovable is the legacy prototype host and should not be used for new deploys.
VITE_PUBLIC_SITE_URL=https://kundaeliko99-byte.github.io/shy-music-source/

# Optional: Android wrapper target. Keep this aligned with the official site URL.
# Native Android changes still require rebuilding and distributing an APK/AAB.
CAPACITOR_SERVER_URL=https://kundaeliko99-byte.github.io/shy-music-source/
